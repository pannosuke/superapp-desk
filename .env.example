# Copy to .env.local. Desk starts with every card disconnected until these are set.
# Do not put CUI, mail bodies, or client tenant secrets in this file or in the app.

# --- Sign-in (Auth.js + Microsoft Entra ID, single tenant) ---
# openssl rand -base64 32
AUTH_SECRET=
# Production URL, for example https://desk.example.com
AUTH_URL=
# Application (client) ID
AZURE_AD_CLIENT_ID=
# Client secret value (not the secret id)
AZURE_AD_CLIENT_SECRET=
# Directory (tenant) ID of Eric's commercial tenant. Never a GCC High tenant.
AZURE_AD_TENANT_ID=
# The only mailbox allowed to open Desk
ALLOWED_EMAIL=

# --- Todoist REST API v2 ---
TODOIST_API_TOKEN=

# --- NinjaOne (commercial instance only, read-only) ---
# Example: https://app.ninjarmm.com
NINJAONE_BASE_URL=
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
# Optional. Defaults to "monitoring management"
NINJAONE_SCOPE=
# Optional board. Otherwise Desk picks a board named like "My Tickets" or "Open".
NINJAONE_BOARD_ID=
# Optional technician id. Otherwise Desk looks up NINJAONE_ASSIGNEE_EMAIL or ALLOWED_EMAIL.
NINJAONE_ASSIGNEE_ID=
NINJAONE_ASSIGNEE_EMAIL=

# --- Notion prep pages (optional) ---
NOTION_TOKEN=

# --- Inbound feed webhook ---
# HMAC-SHA256 of "{timestamp}.{rawBody}", hex, in x-signature
FEED_WEBHOOK_SECRET=

# --- Outbound Grok Bot webhook ---
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_SECRET=

# --- AI. Default provider is google. Switch with AI_PROVIDER=openai or anthropic. ---
AI_PROVIDER=google
# Optional model override. Defaults: gemini-4-argon, gpt-6-astra, claude-sonnet-5-5
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage for feed items, decision flags, and meeting-link ids ---
# Vercel KV is retired. Upstash Redis is the replacement. KV_REST_API_* is accepted as an alias.
# If both Upstash and Neon are set, Upstash wins. If neither is set, Desk uses process memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
NEON_DATABASE_URL=
DATABASE_URL=
